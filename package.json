{
    "name": "insolvency-checker",
    "version": "1.0.0",
    "description": "Node.js Playwright project to check personal IDs for debt status on Israeli insolvency site",
    "main": "index.js",
    "bin": "index.js",
    "scripts": {
        "start": "node index.js",
        "start:headless": "node index.js --headless",
        "test": "pnpm exec playwright test",
        "build:exe": "pnpm exec nexe index.js -- --headless -t windows-x64-22.0.0 -o insolvency-checker.exe --build",
        "install-browsers": "pnpm exec playwright install"
    },
    "keywords": [
        "playwright",
        "automation",
        "insolvency",
        "debt-checker"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "24.3.1",
        "nexe": "5.0.0-beta.4"
    },
    "dependencies": {
        "@playwright/test": "1.55.0",
        "xlsx": "0.18.5"
    }
}