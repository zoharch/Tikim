{
    "name": "insolvency-checker",
    "version": "1.0.0",
    "description": "Node.js Playwright project to check personal IDs for debt status on Israeli insolvency site",
    "main": "index.js",
    "bin": "index.js",
    "scripts": {
        "start": "node index.js",
        "start:headless": "node index.js --headless",
        "test": "pnpm exec playwright test",
        "build:exe": "pkg . --targets node18-win-x64 --output insolvency-checker.exe",
        "install-browsers": "pnpm exec playwright install"
    },
    "keywords": [
        "playwright",
        "automation",
        "insolvency",
        "debt-checker"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@playwright/test": "1.55.0",
        "@types/node": "24.3.1",
        "pkg": "5.8.1"
    },
    "dependencies": {
        "xlsx": "0.18.5"
    }
}